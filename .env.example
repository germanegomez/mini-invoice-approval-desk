# Database connection string
# Option A: Local Docker Compose (docker compose up -d)
DATABASE_URL="postgres://postgres:postgrespassword@localhost:5433/invoice_desk"

# Option B: Neon Serverless PostgreSQL
# DATABASE_URL="postgresql://user:password@ep-something.us-east-2.aws.neon.tech/invoice_desk?sslmode=require"

# Option C: Supabase PostgreSQL
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional port configuration
PORT=3000

# Google Workspace authentication (server-only; never use NEXT_PUBLIC_* names)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-development-secret"
GOOGLE_CLIENT_ID="replace-with-development-client.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-development-client-secret"
GOOGLE_WORKSPACE_DOMAIN="clinicacruzceleste.com"
